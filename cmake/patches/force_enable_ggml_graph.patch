+        static const bool force_graphs = (getenv("GGML_CUDA_GRAPHS_FORCE") != nullptr);
+        if (!force_graphs && ggml_cuda_info().devices[cuda_ctx->device].cc < GGML_CUDA_CC_VOLTA) {
